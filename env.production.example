NODE_ENV=production
# Render supplies PORT automatically; do not hard-code it in the service.
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@HOST/DATABASE?retryWrites=true&w=majority
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=$2b$12$REPLACE_WITH_BCRYPT_HASH
SESSION_SECRET=REPLACE_WITH_32_PLUS_RANDOM_CHARACTERS
TRUST_PROXY=1

# Artifact storage: manual | github | custom_http | firebase
ARTIFACT_STORAGE_MODE=manual

# Optional Cloudinary (icons/screenshots only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional GitHub artifact storage
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_API_BASE=https://api.github.com
GITHUB_RELEASE_PREFIX=apk

# Optional custom HTTP artifact storage
CUSTOM_STORAGE_UPLOAD_URL_TEMPLATE=
CUSTOM_STORAGE_DOWNLOAD_URL_TEMPLATE=
CUSTOM_STORAGE_DELETE_URL_TEMPLATE=
CUSTOM_STORAGE_API_KEY=

# Optional Firebase artifact storage
FIREBASE_STORAGE_BUCKET=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Release limits/timing
APK_MAX_SIZE_BYTES=419430400
ARTIFACT_HTTP_TIMEOUT_MS=120000
RELEASE_WORKER_INTERVAL_MS=4000
STALE_JOB_TIMEOUT_MS=900000
WORKER_HEARTBEAT_INTERVAL_MS=300000
MAX_JOB_ATTEMPTS=3
PATCH_USELESS_RATIO=0.9
